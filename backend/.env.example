# Konfiguracja backendu JOB-HUNTER — skopiuj jako backend/.env
# Google działa bez kluczy (silnik google_free na bibliotece ddgs).

# Opcjonalne nadpisania:
# DEFAULT_TLD=pl
# DB_PATH=/abs/sciezka/jobhunter.db
# SEARCH_DELAY_SECONDS=0.4
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# USER_AGENT=JOB-HUNTER/0.1 (lokalny, osobisty research ofert pracy)